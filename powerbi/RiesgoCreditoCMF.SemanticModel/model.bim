        "measures": [
          {
            "name": "Índice",
            "expression": [
              "IF (",
              "    HASONEVALUE ( Provisiones[Tipo] ),",
              "    AVERAGE ( Provisiones[Valor] )",
              ")"
            ],
            "formatString": "0.00%",
            "lineageTag": "ca816aa0-75d3-5b80-8da7-68f799202ced"
          },
          {
            "name": "Índice Sistema",
            "expression": [
              "CALCULATE (",
              "    [Índice],",
              "    REMOVEFILTERS ( Bancos ),",
              "    Bancos[Segmento] = \"Sistema\"",
              ")"
            ],
            "formatString": "0.00%",
            "lineageTag": "89c24da9-850c-5945-8acf-7ea77b6197fd"
          },
          {
            "name": "Brecha vs Sistema (pp)",
            "expression": [
              "IF (",
              "    NOT ISBLANK ( [Índice] ),",
              "    ( [Índice] - [Índice Sistema] ) * 100",
              ")"
            ],
            "formatString": "+0.00\" pp\";-0.00\" pp\";0.00\" pp\"",
            "lineageTag": "76d73e3a-4a6e-5a83-8332-a4c75a5a37ac"
          },
          {
            "name": "Fecha Último Dato",
            "expression": [
              "CALCULATE ( MAX ( Provisiones[Fecha] ), ALLSELECTED ( Calendario ) )"
            ],
            "formatString": "mmm yyyy",
            "lineageTag": "0f96c1d3-fe3b-5946-a6c3-3db960461331"
          },
          {
            "name": "Índice Último Mes",
            "expression": [
              "VAR UltimaFecha = [Fecha Último Dato]",
              "RETURN",
              "    CALCULATE ( [Índice], Calendario[Fecha] = UltimaFecha )"
            ],
            "formatString": "0.00%",
            "lineageTag": "5514fc03-ff78-5ef3-a32d-a88af5457eed"
          },
          {
            "name": "Var 12 meses (pp)",
            "expression": [
              "VAR UltimaFecha = [Fecha Último Dato]",
              "VAR Actual =",
              "    CALCULATE ( [Índice], Calendario[Fecha] = UltimaFecha )",
              "VAR Anterior =",
              "    CALCULATE (",
              "        [Índice],",
              "        REMOVEFILTERS ( Calendario ),",
              "        Calendario[Fecha] = EDATE ( UltimaFecha, -12 )",
              "    )",
              "RETURN",
              "    IF (",
              "        NOT ISBLANK ( Actual ) && NOT ISBLANK ( Anterior ),",
              "        ( Actual - Anterior ) * 100",
              "    )"
            ],
            "formatString": "+0.00\" pp\";-0.00\" pp\";0.00\" pp\"",
            "lineageTag": "b7864065-0694-513a-b0b8-ee5d78027186"
          },
          {
            "name": "Ranking",
            "expression": [
              "VAR BancosVisibles =",
              "    CALCULATETABLE ( VALUES ( Bancos[Banco] ), ALLSELECTED ( Bancos ) )",
              "RETURN",
              "    IF (",
              "        HASONEVALUE ( Bancos[Banco] ) && NOT ISBLANK ( [Índice] ),",
              "        RANKX (",
              "            BancosVisibles,",
              "            CALCULATE ( [Índice], ALLEXCEPT ( Bancos, Bancos[Banco] ) ),",
              "            ,",
              "            DESC,",
              "            DENSE",
              "        )",
              "    )"
            ],
            "formatString": "0",
            "lineageTag": "b42d55d4-8818-599f-be8a-0ad6d6445a5e"
          },
          {
            "name": "Desv. Estándar (pp)",
            "expression": [
              "VAR MesesConDato =",
              "    FILTER ( VALUES ( Calendario[Fecha] ), NOT ISBLANK ( [Índice] ) )",
              "RETURN",
              "    IF ( COUNTROWS ( MesesConDato ) > 1, STDEVX.S ( MesesConDato, [Índice] ) * 100 )"
            ],
            "formatString": "0.00",
            "lineageTag": "e27d7b82-2daa-5b76-8080-cfb5c99ae8e8"
          },
          {
            "name": "Rango (pp)",
            "expression": [
              "VAR MesesConDato =",
              "    FILTER ( VALUES ( Calendario[Fecha] ), NOT ISBLANK ( [Índice] ) )",
              "RETURN",
              "    ( MAXX ( MesesConDato, [Índice] ) - MINX ( MesesConDato, [Índice] ) ) * 100"
            ],
            "formatString": "0.00",
            "lineageTag": "a94a364c-18b7-55f4-8577-1723c38fd839"
          }
        ]
      }
    ],
