            "type": "calculated",
            "isDataTypeInferred": true,
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( Provisiones[Fecha] ),",
              "    ALLEXCEPT ( Bancos, Bancos[Banco] )",
              ")"
            ]
          }
        ],
        "partitions": [
          {
            "name": "Bancos",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Origen = Csv.Document(",
                "        File.Contents(RutaDatos & \"powerbi\\dim_banco.csv\"),",
                "        [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]",
                "    ),",
                "    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),",
                "    Tipos = Table.TransformColumnTypes(Encabezados, {",
                "        {\"banco_original\", type text},",
                "        {\"banco\", type text},",
                "        {\"segmento\", type text},",
                "        {\"orden_segmento\", Int64.Type},",
                "        {\"nota\", type text}",
                "    }),",
                "    Renombradas = Table.RenameColumns(Tipos, {",
                "        {\"banco_original\", \"Banco Original\"},",
                "        {\"banco\", \"Banco\"},",
                "        {\"segmento\", \"Segmento\"},",
                "        {\"orden_segmento\", \"Orden Segmento\"},",
                "        {\"nota\", \"Nota\"}",
                "    })",
                "in",
                "    Renombradas"
              ]
            }
          }
        ],
        "annotations": [
          {
