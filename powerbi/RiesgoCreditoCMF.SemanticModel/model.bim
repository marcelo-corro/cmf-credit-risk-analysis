        "partitions": [
          {
            "name": "Calendario",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "VAR Inicio = COALESCE ( MIN ( Provisiones[Fecha] ), DATE ( 2016, 1, 1 ) )",
                "VAR Fin = COALESCE ( MAX ( Provisiones[Fecha] ), DATE ( 2016, 1, 1 ) )",
                "VAR Meses =",
                "    FILTER ( CALENDAR ( Inicio, Fin ), DAY ( [Date] ) = 1 )",
                "RETURN",
                "    ADDCOLUMNS (",
                "        SELECTCOLUMNS ( Meses, \"Fecha\", [Date] ),",
                "        \"Año\", YEAR ( [Fecha] ),",
                "        \"Mes\", FORMAT ( [Fecha], \"mmm yyyy\" ),",
                "        \"Orden Mes\", YEAR ( [Fecha] ) * 100 + MONTH ( [Fecha] ),",
                "        \"Período\",",
                "            SWITCH (",
                "                TRUE (),",
                "                [Fecha] < DATE ( 2020, 3, 1 ), \"Pre-COVID\",",
                "                [Fecha] <= DATE ( 2021, 6, 1 ), \"COVID\",",
                "                \"Post-COVID\"",
                "            ),",
                "        \"Orden Período\",",
                "            SWITCH (",
                "                TRUE (),",
                "                [Fecha] < DATE ( 2020, 3, 1 ), 1,",
                "                [Fecha] <= DATE ( 2021, 6, 1 ), 2,",
                "                3",
                "            )",
                "    )"
              ]
            }
          }
        ]
      },
