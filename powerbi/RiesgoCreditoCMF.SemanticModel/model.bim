        "partitions": [
          {
            "name": "Provisiones",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // Lee un CSV del proyecto (UTF-8, primera fila como encabezado)",
                "    LeerCsv = (archivo as text) as table =>",
                "        Table.PromoteHeaders(",
                "            Csv.Document(",
                "                File.Contents(RutaDatos & \"data\\processed\\\" & archivo),",
                "                [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]",
                "            ),",
                "            [PromoteAllScalars = true]",
                "        ),",
                "",
                "    // Bancos + fila oficial del sistema en una sola tabla",
                "    Unidas = Table.Combine({",
                "        LeerCsv(\"provisiones_por_tipo.csv\"),",
                "        LeerCsv(\"provisiones_por_tipo_sistema.csv\")",
                "    }),",
                "",
                "    // De una columna por tipo a una fila por banco, mes y tipo de crédito",
                "    Largo = Table.UnpivotOtherColumns(Unidas, {\"fecha\", \"banco\"}, \"Tipo\", \"Valor\"),",
                "    SinVacios = Table.SelectRows(Largo, each [Valor] <> \"\" and [Valor] <> null),",
                "",
                "    // \"indice_consumo\" -> \"Consumo\"",
                "    TipoLimpio = Table.TransformColumns(",
                "        SinVacios,",
                "        {{\"Tipo\", each Text.Proper(Text.AfterDelimiter(_, \"indice_\")), type text}}",
                "    ),",
                "",
                "    // Los CSV usan punto decimal: se convierte con cultura en-US",
                "    // para que el resultado no dependa del idioma de Windows",
                "    Tipos = Table.TransformColumnTypes(",
                "        TipoLimpio,",
                "        {{\"fecha\", type date}, {\"banco\", type text}, {\"Valor\", type number}},",
                "        \"en-US\"",
                "    ),",
                "",
                "    // 7.28 -> 0.0728, para usar formato de porcentaje",
                "    Proporcion = Table.TransformColumns(Tipos, {{\"Valor\", each _ / 100, type number}}),",
                "",
                "    Renombradas = Table.RenameColumns(Proporcion, {{\"fecha\", \"Fecha\"}, {\"banco\", \"Banco Original\"}})",
                "in",
                "    Renombradas"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
